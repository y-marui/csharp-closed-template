<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <!-- UpgradeCode は製品ごとに固定の GUID。テンプレートから作ったら新しく採番し、以後変えない
       （PowerShell: [guid]::NewGuid()） -->
  <Package Name="MyApp"
           Manufacturer="Example Author"
           Version="$(Version)"
           UpgradeCode="9da1b080-a6df-4208-828a-2e7957f86337"
           Scope="perMachine">

    <MajorUpgrade DowngradeErrorMessage="A newer version of MyApp is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- publish したフォルダを丸ごと取り込む（Heat によるハーベストは非推奨） -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="MyApp">
        <Files Include="$(PublishDir)\**" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="MyApp">
        <Component Id="StartMenuShortcut" Guid="*">
          <Shortcut Id="StartMenuShortcutFile"
                    Name="MyApp"
                    Target="[INSTALLFOLDER]MyApp.App.exe"
                    WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
          <RegistryValue Root="HKCU" Key="Software\MyApp" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

  </Package>
</Wix>
